# Demo setup. Copy this file to .env and set DEEPSEEK_API_KEY.
# Cascade calls DeepSeek only when rules and kNN do not settle the case.
# The model proposes a category row. It does not write the answer.
# LLM_BACKEND=RULES_ONLY skips that call. Use it only for an offline run.
LLM_BACKEND=DEEPSEEK
TRIAGE_PATH=cascade
LLM_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
